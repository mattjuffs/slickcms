@model ErrorViewModel
@{
    ViewData["MetaTitle"] = "Error";
    ViewData["MetaDescription"] = "An error occurred while processing your request.";
}

<h1 class="text-danger title"><span>Error</span></h1>

<div class="block">
    <section>
        <h2 class="text-danger">An error occurred while processing your request.</h2>

        @*<p>HTTP Status Code: @Model.HttpStatusCode</p>*@

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <p>Try using the <strong>Search</strong> to find what you were looking for, or visit the <a href="/posts">Posts</a> pages</p>
    </section>
</div>
