@model SlickCMS.Web.Models.PostsModel

@{
    ViewData["MetaTitle"] = Model.Name + " Tag";
    ViewData["MetaDescription"] = "Posts tagged: " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title"><span>@Model.Name</span></h1>

<div class="block">
    <section>
        <ol class="breadcrumbs clearfix">
            <li><a href="/">Home</a></li>
            @*<li><a href="/tags">Tags</a></li>*@
            @{
                if (Model.Pagination.CurrentPage > 1)
                {
                    <li class="current"><a href="/tag/@Model.Name&page=@Model.Pagination.CurrentPage">#@Model.Name</a></li>
                }
                else
                {
                    <li class="current"><a href="/tag/@Model.Name">#@Model.Name</a></li>
                }
            }
        </ol>
    </section>

    <section class="">
        <p>@Model.Pagination.TotalPosts posts tagged <strong>@Model.Name</strong></p>
    </section>

    <section>
        <partial name="_Posts" model="Model.Posts" />
    </section>

    <section>
        <partial name="_Pagination" model="Model" />
    </section>
</div>
