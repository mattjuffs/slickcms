@model IEnumerable<SlickCMS.Data.Entities.Post>
@{
    string currentYear = "";
}

<ul class="posts">
    @foreach (var item in Model)
    {
        {
            if (currentYear != item.DateCreated.ToString("yyyy")) {
                currentYear = item.DateCreated.ToString("yyyy");
                <text><li><h2 class="year">@currentYear</h2></li></text>
            }
        }

        <li>
            <div class="row-fluid">
                <div class="span8">
                    <p>
                        <a href="/post/@item.Url">@item.Title</a><br />
                        <em>@item.Summary</em><br />
                    </p>
                </div>
                <div class="span4">
                    <p class="meta">
                        @item.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")<br />
                        @item.DateCreated.ToHumanDate()
                    </p>
                </div>
            </div>
        </li>
    }
</ul>
