@model SlickCMS.Web.Models.PostModel

@{
    ViewData["MetaTitle"] = Model.Post.Title;
    ViewData["MetaDescription"] = Model.Post.Summary;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="title"><span>@Model.Post.Title</span></h1>

<div class="block">
    <section id="breadcrumbs">
        <ol class="breadcrumbs clearfix">
            <li><a href="/">Home</a></li>
            <li><a href="/posts">Posts</a></li>
            <li class="current"><a href="/post/@Model.Post.Url">@Model.Post.Title</a></li>
        </ol>
    </section>

    <article>
        @Html.Raw(Model.Post.Content)
    </article>

    <section id="meta">
        <p class="meta">
            Written: @Model.Post.DateCreated.ToString("yyyy-MM-dd HH:mm:ss") | @Model.Post.DateCreated.ToHumanDate()
            @if (Model.Post.DateCreated < Model.Post.DateModified) {
                <text><br />Edited: @Model.Post.DateModified.ToString("yyyy-MM-dd HH:mm:ss") | @Model.Post.DateModified.ToHumanDate()</text>
            }
        </p>
    </section>

    <partial name="_Categories" model="Model.Categories" />

    <partial name="_Tags" model="Model.Tags" />

    <partial name="_Comments" model="Model.Comments" />

    <partial name="_CommentForm" model="Model.Post" />
</div>
