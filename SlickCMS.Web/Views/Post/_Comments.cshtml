@model List<SlickCMS.Data.Entities.Comment>

<section id="comments">
    <h2>Comments <span>that have been left by lovely people like yourself</span></h2>

    @{
        int even = 0;
        foreach (var comment in Model)
        {
            even++;
            <div class="row-fluid comment comment-@((even % 2) == 0 ? "even" : "odd")">
                <div class="span8">
                    @{
                        if (comment.Content.StartsWith("<p>"))
                        {
                            @Html.Raw(comment.Content)
                        }
                        else
                        {
                            <p>@Html.Raw(comment.Content)</p>
                        }
                    }
                </div>
                <div class="span4">
                    <p>
                        @{
                            if ((comment.Url + "") != "")
                            {
                                <strong><a href="@comment.Url">@comment.Name</a></strong><br />
                            }
                            else
                            {
                                <strong>@comment.Name</strong><br />
                            }
                        }

                        <em><time>@comment.DateCreated.ToHumanDate()</time></em>
                    </p>
                </div>
            </div>
            <hr />
        }
    }

    @{
        if (Model.Count == 0)
        {
            <div class="row-fluid">
                <div class="span8">
                    <p><em>There are no Comments at this time.</em></p>
                </div>
            </div>
            <hr />
        }
    }
</section>
